#!/usr/bin/env bash
# Runner script for {{SKILL_NAME}}
# Activates the venv and forwards all arguments to main.py.
#
# Usage: bash run.sh <command> [args...]

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VENV_DIR="$SCRIPT_DIR/.venv"

if [ ! -d "$VENV_DIR" ]; then
    echo '{"error": "venv_missing", "hint": "Run: python3 scripts/main.py setup", "recoverable": true}' >&2
    exit 1
fi

source "$VENV_DIR/bin/activate"
python3 "$SCRIPT_DIR/main.py" "$@"
